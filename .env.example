# Connect as the least-privileged role created by db/roles.sql, never as the owner.
DATABASE_URL=postgres://mcp_readonly:mcp_readonly_dev@localhost:5432/inventory

# Per-statement timeout applied with SET LOCAL inside every read-only transaction.
STATEMENT_TIMEOUT_MS=5000

# Upper bound on one tool result's JSON body, in bytes (4096-1048576). Rows are
# dropped from the end until the response fits, and the result says truncated.
MAX_RESPONSE_BYTES=65536

# Longest string a single cell may carry (100-100000). Longer values are cut
# and end with "…[truncated N chars]".
MAX_CELL_CHARS=1000
