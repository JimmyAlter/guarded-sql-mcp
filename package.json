{
  "name": "guarded-sql-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes PostgreSQL to LLM agents through a fixed catalog of parameterized, read-only queries.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "postgresql",
    "llm-security",
    "ai-agents",
    "read-only",
    "sql"
  ],
  "homepage": "https://github.com/JimmyAlter/guarded-sql-mcp#readme",
  "bugs": {
    "url": "https://github.com/JimmyAlter/guarded-sql-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimmyAlter/guarded-sql-mcp.git"
  },
  "license": "MIT",
  "author": "Thiago Langone",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "guarded-sql-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "db",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-stdio.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
